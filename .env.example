# 复制为 .env 后填写。没有 Key 也能浏览图谱并使用本地检索；
# AI 生成回答、图片理解和向量检索需要 DashScope API Key。
DASHSCOPE_API_KEY=

# 模型
TEXT_MODEL=qwen3.7-plus
MM_MODEL=qwen3.7-plus
EMBED_MODEL=qwen3-vl-embedding
EMBED_DIM=1024
EMBED_BATCH_SIZE=8
EMBED_CANDIDATE_POOL=36

# 服务
HOST=127.0.0.1
PORT=8000
ALLOW_GRAPH_WRITE=false

# 检索参数（通常无需修改）
TOP_K=8
RETRIEVAL_THRESHOLD=0.18
NUMBER_OF_MMENTITIES=4
IMAGE_RETRIEVAL_THRESHOLD=0.14
IMAGE_RELATIVE_THRESHOLD=0.72
IMAGE_MIN_LEXICAL_SCORE=0.04
MAX_RELATIONS=18
MAX_CHUNKS=3
MAX_UPLOAD_MB=12
MAX_OUTPUT_TOKENS=1600

# 所有数据默认位于项目内，无需配置路径。高级部署才需要取消注释覆盖。
# DATA_DIR=data
# GRAPHML_PATH=data/graph/example_mmkg.graphml
# IMAGE_DATA_PATH=data/metadata/kv_store_image_data.json
# TEXT_CHUNKS_PATH=data/metadata/kv_store_text_chunks.json
# IMAGE_DIR=data/images
# CACHE_DIR=data/cache
# UPLOAD_DIR=data/uploads
# BACKUP_DIR=data/backups
