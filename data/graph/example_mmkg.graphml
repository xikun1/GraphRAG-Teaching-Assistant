<graph edgedefault="undirected"><node id="自动驾驶">
  <data key="entity_type">基础概念</data>
  <data key="description">车辆在给定运行条件下完成部分或全部动态驾驶任务。</data>
  <data key="source_id">chunk-overview</data>
</node>
<node id="环境感知">
  <data key="entity_type">核心技术</data>
  <data key="description">从传感器观测识别可行驶区域、道路标记和交通参与者。</data>
  <data key="source_id">chunk-overview</data>
</node>
<node id="定位与建图">
  <data key="entity_type">核心技术</data>
  <data key="description">估计车辆在地图中的位置与姿态，并维护环境的空间表示。</data>
  <data key="source_id">chunk-overview</data>
</node>
<node id="决策规划">
  <data key="entity_type">核心技术</data>
  <data key="description">结合路线、障碍物预测和交通规则选择行为与行驶轨迹。</data>
  <data key="source_id">chunk-overview</data>
</node>
<node id="车辆控制">
  <data key="entity_type">核心技术</data>
  <data key="description">闭环地把规划轨迹转成执行器指令。</data>
  <data key="source_id">chunk-overview</data>
</node>
<node id="安全验证">
  <data key="entity_type">基础概念</data>
  <data key="description">用可复现的场景、指标和试验验证系统的安全目标。</data>
  <data key="source_id">chunk-overview</data>
</node>
<node id="摄像头">
  <data key="entity_type">产品/设备</data>
  <data key="description">采集二维图像，提供信号灯颜色、交通标志、纹理和车道线等信息。</data>
  <data key="source_id">chunk-sensors</data>
</node>
<node id="激光雷达">
  <data key="entity_type">产品/设备</data>
  <data key="description">LiDAR 根据激光往返时间估算距离，形成三维点云，用于障碍物定位和环境几何建模。</data>
  <data key="source_id">chunk-sensors</data>
</node>
<node id="毫米波雷达">
  <data key="entity_type">产品/设备</data>
  <data key="description">利用射频回波估计距离、方位和径向速度。与激光雷达的几何测量互补。</data>
  <data key="source_id">chunk-sensors</data>
</node>
<node id="传感器融合">
  <data key="entity_type">核心技术</data>
  <data key="description">对齐时空坐标后合并摄像头、激光雷达和毫米波雷达的观测，减少单一传感器的盲区。</data>
  <data key="source_id">chunk-sensors</data>
</node>
<node id="三维点云">
  <data key="entity_type">数据</data>
  <data key="description">由带空间坐标的测量点组成，描述障碍物与地面的形状。</data>
  <data key="source_id">chunk-sensors</data>
</node>
<node id="目标检测">
  <data key="entity_type">核心技术</data>
  <data key="description">从图像或点云估计物体类别与位置，可输出二维或三维边界框。</data>
  <data key="source_id">chunk-sensors</data>
</node>
<node id="目标跟踪">
  <data key="entity_type">核心技术</data>
  <data key="description">以连续帧观测关联同一物体，估计其速度和轨迹。</data>
  <data key="source_id">chunk-sensors</data>
</node>
<node id="车道线识别">
  <data key="entity_type">核心技术</data>
  <data key="description">从道路画面估计车道标线及其几何位置。</data>
  <data key="source_id">chunk-sensors</data>
</node>
<node id="相机与雷达外参">
  <data key="entity_type">基础概念</data>
  <data key="description">不同传感器坐标系间的刚体变换，通过标定得到。</data>
  <data key="source_id">chunk-sensors</data>
</node>
<node id="时间同步">
  <data key="entity_type">基础概念</data>
  <data key="description">对齐测量时间戳，减少运动造成的跨传感器匹配误差。</data>
  <data key="source_id">chunk-sensors</data>
</node>
<node id="径向速度">
  <data key="entity_type">性能指标</data>
  <data key="description">目标沿雷达视线方向的速度分量。</data>
  <data key="source_id">chunk-sensors</data>
</node>
<node id="卫星定位">
  <data key="entity_type">核心技术</data>
  <data key="description">GNSS 提供全球坐标参考，精度受遮挡和多径传播影响。</data>
  <data key="source_id">chunk-localization</data>
</node>
<node id="惯性测量单元">
  <data key="entity_type">产品/设备</data>
  <data key="description">IMU 测量角速度与比力，用于估计短时车身运动。</data>
  <data key="source_id">chunk-localization</data>
</node>
<node id="车轮里程计">
  <data key="entity_type">产品/设备</data>
  <data key="description">根据车轮转速估计行驶距离和短时速度，打滑时误差会增大。</data>
  <data key="source_id">chunk-localization</data>
</node>
<node id="地图匹配">
  <data key="entity_type">核心技术</data>
  <data key="description">把车辆观测与地图特征匹配以约束车辆位姿。</data>
  <data key="source_id">chunk-localization</data>
</node>
<node id="高精地图">
  <data key="entity_type">数据</data>
  <data key="description">以结构化形式记录车道几何、边界和道路连接关系。</data>
  <data key="source_id">chunk-localization</data>
</node>
<node id="行为决策">
  <data key="entity_type">核心技术</data>
  <data key="description">结合道路语义和交互情况选择跟车、换道、让行或停车。</data>
  <data key="source_id">chunk-planning</data>
</node>
<node id="运动预测">
  <data key="entity_type">核心技术</data>
  <data key="description">根据历史观测和道路结构估计交通参与者未来的可能轨迹。</data>
  <data key="source_id">chunk-planning</data>
</node>
<node id="轨迹规划">
  <data key="entity_type">核心技术</data>
  <data key="description">生成满足碰撞约束和车辆可达性约束的位置及速度序列。</data>
  <data key="source_id">chunk-planning</data>
</node>
<node id="碰撞检查">
  <data key="entity_type">核心技术</data>
  <data key="description">沿候选轨迹检验车身占用区域是否与预测障碍物相交。</data>
  <data key="source_id">chunk-planning</data>
</node>
<node id="速度曲线">
  <data key="entity_type">数据</data>
  <data key="description">记录车辆随时间的目标速度，供纵向控制跟踪。</data>
  <data key="source_id">chunk-planning</data>
</node>
<node id="横向控制">
  <data key="entity_type">核心技术</data>
  <data key="description">通过转向减少车辆相对参考路径的横向位置和航向误差。</data>
  <data key="source_id">chunk-control</data>
</node>
<node id="纵向控制">
  <data key="entity_type">核心技术</data>
  <data key="description">通过驱动和制动跟踪目标速度或跟车距离。</data>
  <data key="source_id">chunk-control</data>
</node>
<node id="车辆动力学">
  <data key="entity_type">基础概念</data>
  <data key="description">描述力、转向和轮胎状态如何影响车辆运动。</data>
  <data key="source_id">chunk-control</data>
</node>
<node id="轨迹跟踪误差">
  <data key="entity_type">性能指标</data>
  <data key="description">实测车辆状态相对于参考轨迹的偏差，可用于调节控制器。</data>
  <data key="source_id">chunk-control</data>
</node>
<node id="运行设计域">
  <data key="entity_type">基础概念</data>
  <data key="description">ODD 规定系统可使用的道路、地理区域、速度范围和环境条件。</data>
  <data key="source_id">chunk-safety</data>
</node>
<node id="最小风险策略">
  <data key="entity_type">基础概念</data>
  <data key="description">当前自动驾驶任务无法安全继续时，依据系统设计执行风险降低动作。</data>
  <data key="source_id">chunk-safety</data>
</node>
<node id="场景仿真">
  <data key="entity_type">核心技术</data>
  <data key="description">以可控条件反复测试交互和罕见场景，记录系统反应。</data>
  <data key="source_id">chunk-safety</data>
</node>
<node id="封闭场地测试">
  <data key="entity_type">基础概念</data>
  <data key="description">在隔离环境内用实体设备验证关键风险场景和执行链路。</data>
  <data key="source_id">chunk-safety</data>
</node>
<node id="感知置信度">
  <data key="entity_type">性能指标</data>
  <data key="description">描述系统对感知结果可靠性的估计，需结合实际数据评估校准。</data>
  <data key="source_id">chunk-safety</data>
</node>
<node id="激光雷达测距示意">
  <data key="entity_type">ORI_IMG</data>
  <data key="description">激光脉冲照射目标表面后返回传感器。往返飞行时间乘以光速再除以二，可估算目标距离。</data>
  <data key="source_id">data/images/lidar-ranging.png</data>
</node>
<node id="传感器融合流程图">
  <data key="entity_type">ORI_IMG</data>
  <data key="description">摄像头、激光雷达和毫米波雷达的数据先对齐时间和坐标，再结合各观测的可靠性估计目标状态。</data>
  <data key="source_id">data/images/sensor-fusion.png</data>
</node>
